# Local PostgreSQL example.
# For Neon/Vercel, replace these with the pooled and direct Neon URLs.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/household_monthly"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/household_monthly"

# Generate a stronger value for production:
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Used only when running npm run db:seed.
# Change these before seeding a serious/cloud database.
SEED_SUAMI_PASSWORD="password123"
SEED_ISTRI_PASSWORD="password123"

# Optional Catat AI. Shortcuts like "gorengan 5k" work without any key.
# OpenAI-compatible: first filled key is tried, then _2, _3, ... on failure.
# CATAT_AI_MODEL is optional. Empty = auto from GET /models (DeepSeek defaults to deepseek-chat).
# DeepSeek:   https://api.deepseek.com          model deepseek-chat
# Fortytwo:   https://api.fortytwo.network/v1   model qwen/qwen3.8-27b  (label: Qwen3.8 27B)
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# xAI:        https://api.x.ai/v1
CATAT_AI_BASE_URL="https://api.fortytwo.network/v1"
CATAT_AI_API_KEY=""
CATAT_AI_MODEL="qwen/qwen3.8-27b"

CATAT_AI_BASE_URL_2=""
CATAT_AI_API_KEY_2=""
CATAT_AI_MODEL_2=""

CATAT_AI_BASE_URL_3=""
CATAT_AI_API_KEY_3=""
CATAT_AI_MODEL_3=""

# Legacy alias. Still works if CATAT_AI_API_KEY is empty.
DEEPSEEK_API_KEY=""
